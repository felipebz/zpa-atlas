      <ProgramUnit TEST29_overridden:Name="MSG_ALERT" TEST29_default:PersistentClientInfoLength="0" TEST29_overridden:ProgramUnitText="procedure msg_alert(&amp;#10;errm in VARCHAR2,           /* message */&amp;#10;errt in VARCHAR2,           /* message type */&amp;#10;rftf in boolean         /* raise form_trigger_failure ? */&amp;#10;) is      /* message parameters */&amp;#10;/*&amp;#10;* ----------------------------------------------------------------&amp;#10;* CHANGE HISTORY:&amp;#10;* DATE   PERSON      CHANGE&amp;#10;* ------ ----------- ---------------------------------------------&amp;#10;*&amp;#10;*/&amp;#10;&amp;#10;alert_is alert;&amp;#10;alert_button number;&amp;#10;&amp;#10;BEGIN&amp;#10;        &amp;#10;     IF (errt = 'F')&amp;#10;     THEN alert_is := FIND_ALERT('CFG_SYSTEM_ERROR');&amp;#10;     ELSIF (errt = 'E')&amp;#10;        THEN alert_is := FIND_ALERT('CFG_ERROR');&amp;#10;        ELSIF (errt = 'W')&amp;#10;           THEN alert_is := FIND_ALERT('CFG_WARNING_A');&amp;#10;              ELSIF (errt = 'I')&amp;#10;                 THEN alert_is := FIND_ALERT('CFG_INFORMATION');&amp;#10;                 ELSE MESSAGE(errm);&amp;#10;     end if;&amp;#10;     &amp;#10;     IF (errt IN ('F','E','W','I'))&amp;#10;     THEN SET_ALERT_PROPERTY(alert_is,ALERT_MESSAGE_TEXT,errm);&amp;#10;          alert_button := SHOW_ALERT(alert_is);&amp;#10;     END IF;&amp;#10;&amp;#10;     IF (rftf)&amp;#10;     THEN&amp;#10;       RAISE FORM_TRIGGER_FAILURE;&amp;#10;     END IF;&amp;#10;&amp;#10;&amp;#10;END;&amp;#10;" TEST29_overridden:ProgramUnitType="Procedimento" TEST29_default:Comment=""/>
