      <Trigger SHOP_DESK_overridden:Name="WHEN-NEW-FORM-INSTANCE" SHOP_DESK_overridden:TriggerText="DECLARE&amp;#10;  CURSOR c_ord IS SELECT status FROM orders WHERE order_id = 1;&amp;#10;  r_ord orders%ROWTYPE;&amp;#10;BEGIN&amp;#10;  SELECT status INTO :ctrl.short_status FROM orders WHERE order_id = 1;&amp;#10;  OPEN c_ord;&amp;#10;  FETCH c_ord INTO :ctrl.short_status;&amp;#10;  CLOSE c_ord;&amp;#10;  :ctrl.short_status := r_ord.status;&amp;#10;  :ctrl.short_status := NVL(r_ord.status, '-');&amp;#10;  SELECT status INTO :ctrl.default_status FROM orders WHERE order_id = 1;&amp;#10;  SELECT status INTO :ctrl.wide_status FROM orders WHERE order_id = 1;&amp;#10;  SELECT status INTO :ctrl.count_id FROM orders WHERE order_id = 1;&amp;#10;  SELECT status INTO :ctrl.status_list FROM orders WHERE order_id = 1;&amp;#10;  SELECT status INTO :ctrl.bare_status FROM orders WHERE order_id = 1;&amp;#10;  read_status(1, :ctrl.short_status);&amp;#10;  SELECT status INTO :only_here FROM orders WHERE order_id = 1;&amp;#10;  SELECT status INTO :dup FROM orders WHERE order_id = 1;&amp;#10;  SELECT status INTO :nope.z FROM orders WHERE order_id = 1;&amp;#10;  SELECT status INTO :parameter.p_status FROM orders WHERE order_id = 1;&amp;#10;  SELECT status INTO :global.last_status FROM orders WHERE order_id = 1;&amp;#10;  SELECT status INTO :system.message_level FROM orders WHERE order_id = 1;&amp;#10;END;"/>
