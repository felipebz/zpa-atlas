<?xml version = '1.0' encoding = 'UTF-8'?>
<Module version="122010300" Dump="All" xmlns:ROUTE_DESK_default="http://xmlns.oracle.com/Forms"
        xmlns:ROUTE_DESK_overridden="http://xmlns.oracle.com/Forms" xmlns="http://xmlns.oracle.com/Forms">
   <FormModule ROUTE_DESK_overridden:Name="ROUTE_DESK">
      <Block ROUTE_DESK_overridden:Name="STOPS" ROUTE_DESK_overridden:DatabaseBlock="false">
         <Item ROUTE_DESK_overridden:Name="STOP_ID" ROUTE_DESK_overridden:DatabaseItem="false">
            <Trigger ROUTE_DESK_overridden:Name="WHEN-VALIDATE-ITEM" ROUTE_DESK_default:TriggerStyle="PL/SQL" ROUTE_DESK_overridden:TriggerText="select count(*) into :stops.note from dual where dummy = :stops.stop_id;&amp;#10;route_next(:stops.city);&amp;#10;execute_trigger('check_stop');&amp;#10;execute_trigger('REFRESH_STOP');&amp;#10;execute_trigger('LOG_ROUTE');"/>
            <Trigger ROUTE_DESK_overridden:Name="CHECK_STOP" ROUTE_DESK_default:TriggerStyle="PL/SQL" ROUTE_DESK_overridden:TriggerText="null;"/>
         </Item>
         <Item ROUTE_DESK_overridden:Name="CITY" ROUTE_DESK_overridden:DatabaseItem="false"/>
         <Item ROUTE_DESK_overridden:Name="NOTE" ROUTE_DESK_overridden:DatabaseItem="false"/>
         <Trigger ROUTE_DESK_overridden:Name="WHEN-NEW-RECORD-INSTANCE" ROUTE_DESK_default:TriggerStyle="PL/SQL" ROUTE_DESK_overridden:TriggerText=":note := :city || :distance;&amp;#10;message(:stops.rowid);"/>
         <Trigger ROUTE_DESK_overridden:Name="REFRESH_STOP" ROUTE_DESK_default:TriggerStyle="PL/SQL" ROUTE_DESK_overridden:TriggerText="null;"/>
      </Block>
      <Block ROUTE_DESK_overridden:Name="LEGS" ROUTE_DESK_overridden:DatabaseBlock="false">
         <Item ROUTE_DESK_overridden:Name="LEG_ID" ROUTE_DESK_overridden:DatabaseItem="false"/>
         <Item ROUTE_DESK_overridden:Name="CITY" ROUTE_DESK_overridden:DatabaseItem="false"/>
         <Item ROUTE_DESK_overridden:Name="DISTANCE" ROUTE_DESK_overridden:DatabaseItem="false"/>
      </Block>
      <Trigger ROUTE_DESK_overridden:Name="WHEN-NEW-FORM-INSTANCE" ROUTE_DESK_default:TriggerStyle="PL/SQL" ROUTE_DESK_overridden:TriggerText="DECLARE&amp;#10;  v_name varchar2(30) := 'LEGS';&amp;#10;BEGIN&amp;#10;  :global.route_user := user;&amp;#10;  :distance := 0;&amp;#10;  message(:city);&amp;#10;  :stops.city := :parameter.p_city;&amp;#10;  message(:parameter.p_none);&amp;#10;  message(:nowhere.city);&amp;#10;  message(:stops.nothing);&amp;#10;  message(:system.cursor_item);&amp;#10;  go_block('LEGS');&amp;#10;  go_item('LEGS.DISTANCE');&amp;#10;  go_item('distance');&amp;#10;  execute_trigger('CHECK_STOP');&amp;#10;  call_form('route_view');&amp;#10;  call_form('/forms/route_view.fmx');&amp;#10;  call_form('ROUTE_GONE');&amp;#10;  go_block(v_name);&amp;#10;  go_item(v_name);&amp;#10;  execute_trigger(v_name);&amp;#10;  call_form(v_name);&amp;#10;  execute_trigger('REFRESH_STOP');&amp;#10;  execute_trigger('LOG_ROUTE');&amp;#10;END;"/>
      <Trigger ROUTE_DESK_overridden:Name="REFRESH_STOP" ROUTE_DESK_default:TriggerStyle="PL/SQL" ROUTE_DESK_overridden:TriggerText="null;"/>
      <Trigger ROUTE_DESK_overridden:Name="LOG_ROUTE" ROUTE_DESK_default:TriggerStyle="PL/SQL" ROUTE_DESK_overridden:TriggerText="null;"/>
      <ModuleParameter ROUTE_DESK_overridden:Name="P_CITY" ROUTE_DESK_default:ParameterDataType="Char"/>
   </FormModule>
</Module>
